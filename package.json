{
  "name": "deptend",
  "version": "0.0.1",
  "private": true,
  "description": "deptend.dev — maintenance-first dependency dashboard",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter app dev",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @deptend/core build && pnpm -r typecheck && pnpm --filter @deptend/core typecheck:tests && pnpm --filter cli typecheck:tests",
    "test": "pnpm -r test",
    "prepare": "husky",
    "postinstall": "pnpm --filter @deptend/core build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "postgres": "^3.4.9",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,css}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "nanoid": "^3.3.18",
      "sharp": "^0.35.3"
    }
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@renovatebot/pep440": "^5.0.0",
    "@yarnpkg/lockfile": "^1.0.0",
    "drizzle-orm": "^0.45.2",
    "semver": "^7.8.5",
    "smol-toml": "^1.7.0"
  }
}
