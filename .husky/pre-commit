# Pre-commit guard (2026-10-31): AGENTS.md is local-only and must never be
# committed. A pure staged DELETION is allowed (the one-time untrack); any
# staged content (re-track via `git add -f`, modify, re-add) fails loudly.
if git diff --cached --check-ignore -- AGENTS.md | grep -q .; then
  if git diff --cached --numstat -- AGENTS.md | grep -v '^0' | grep -q .; then
    echo ""
    echo "ERROR: AGENTS.md has staged content (add/modify/re-track)."
    echo "AGENTS.md is local-only by policy (Mico, 2026-10-31) — it must NEVER be committed."
    echo ""
    echo "To fix:  git restore --staged AGENTS.md"
    echo ""
    exit 1
  fi
fi

pnpm lint-staged
