# Pre-commit guard (2026-10-31): AGENTS.md is local-only and must never be
# committed. A staged DELETION is allowed (the one-time untrack); staged
# content (re-track via `git add -f`, add, modify, rename-in) fails loudly.
code="$(git diff --cached --name-status -- AGENTS.md | cut -f1 | head -n1)"
if [ -n "$code" ] && [ "$code" != "D" ]; then
  echo ""
  echo "ERROR: AGENTS.md has staged content (status: $code)."
  echo "AGENTS.md is local-only by policy (Mico, 2026-10-31) — it must NEVER be committed."
  echo ""
  echo "To fix:  git restore --staged AGENTS.md"
  echo ""
  exit 1
fi

pnpm lint-staged
