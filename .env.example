# =============================================================================
# deptend.dev — Environment Variables
# Copy this file to .env.local (never commit .env.local)
# =============================================================================

# --- Database (Neon PostgreSQL) ---
# Get from: https://console.neon.tech → your project → Connection string
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# --- GitHub OAuth ---
# Create at: https://github.com/settings/developers → OAuth Apps
GH_CLIENT_ID=""
GH_CLIENT_SECRET=""

# --- GitHub API Token ---
# Personal access token (classic) — read:public_repo scope only
# Required for GHSA queries and to avoid 60 req/hr rate limit
# Read by scripts/ingest.js and the CLI. Also read by /app's repo-submission
# manifest pre-check (Roadmap "Now #4", Option A) if set — but that route
# runs on Vercel, not Actions, so it only sees this if it's set as an actual
# Vercel env var too, separately from any GitHub Actions secret of the same
# name. Falls back to unauthenticated (60 req/hr, shared globally) if unset
# there; not currently set in Vercel as of this comment.
GITHUB_TOKEN=""

# --- On-demand ingestion (repo submission) ---
# Fine-grained PAT scoped to this repo only, actions: write — triggers
# workflow_dispatch from the API route on repo submission. Distinct from
# GITHUB_TOKEN above, which is auto-injected inside Actions runs only and
# can't be used from an external process (see ADR 0013).
GH_DISPATCH_TOKEN=""
# "owner/name" for deptend.dev's own repo (not the submitted target repo)
GH_REPO=""

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Set to your Vercel URL in production; http://localhost:3000 in dev
NEXTAUTH_URL="http://localhost:3000"

# --- App ---
# Hard cap on indexed repos. Application layer enforces this (see ADR 0028).
NEXT_PUBLIC_MAX_REPOS="150"

# --- libraries.io (downstream dependents, ADR 0032) ---
# Free-tier key from https://libraries.io/api — account signup, no credit card.
# Powers the downstream_dependents prefetch (60 req/min budget paced
# client-side). Absent ⇒ missions keep the downstream_dependents flag set
# and surface "not tracked yet" in the UI; the rest of the pipeline is
# unaffected. Only set in CI/Neon env in practice.
LIBRARIES_IO_API_KEY=""
